NODE_ENV=development
PORT=3100
PUBLIC_URL=http://localhost:3100/careeros
BASE_PATH=/careeros
POSTGRES_PASSWORD=replace-with-random-password
DATABASE_URL=postgresql://careeros:development-only@localhost:5432/careeros
DATA_DIR=./data
# Generate: openssl rand -hex 32. Never commit real secrets.
ENCRYPTION_KEY=
# Generate a random token to permit the first owner account. Never expose in public docs.
BOOTSTRAP_TOKEN=
REGISTRATION_OPEN=false
ANTHROPIC_MODEL=claude-sonnet-4-6
RECOVERY_EPOCH=1
SUBMISSIONS_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
